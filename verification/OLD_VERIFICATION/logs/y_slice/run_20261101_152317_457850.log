#include "VDmaModule.h"
#include "verilated.h"
#include <algorithm>
#include <cstdint>
#include <deque>
#include <iostream>
#include <map>
#include <random>
#include <stdexcept>
constexpr unsigned N=@N@;
struct Entry{uint64_t data;bool returned=false;};
VDmaModule dut;
std::map<unsigned,Entry> live;
std::deque<unsigned> order;
unsigned sent=0,received=0,peak=0,seen=0,reversed=0,simultaneous=0;
uint64_t payload(unsigned n){return 0x1234000000000000ULL | (uint64_t(n)<<8) | (n%3==0);}
void need(bool ok,const char *why){if(!ok)throw std::runtime_error(why);}
void set_response(unsigned id,uint64_t data){@SET_SOURCE@ dut.auto_out_d_bits_data=data;dut.auto_out_d_valid=1;}
bool tick(){
 dut.clock=0;dut.eval();bool accept=dut.io_a_fire,deliver=dut.io_d_valid;
 if(!dut.reset){
  if(accept){unsigned id=@GET_SOURCE@;need(id<N&&!live.count(id),"invalid/reused source");
   need(dut.auto_out_a_bits_address==dut.io_addr,"wrong request address");
   need(dut.auto_out_a_bits_opcode==(dut.io_mode==0?4:1),"wrong Get/PutPartial opcode");
   live[id]={payload(sent),false};order.push_back(id);++sent;seen|=1U<<id;
  }
  if(dut.auto_out_d_valid){unsigned id=@READ_SOURCE@;need(id<N&&live.count(id)&&!live.at(id).returned,"invalid/duplicate response");
   bool older_missing=false;for(unsigned older:order){if(older==id)break;if(!live.at(older).returned)older_missing=true;}
   if(older_missing)++reversed;
   need(dut.auto_out_d_bits_data==live.at(id).data,"bad test payload");live.at(id).returned=true;
  }
  if(deliver){need(!order.empty(),"unexpected delivery");unsigned id=order.front();
   need(live.at(id).returned&&dut.io_readData==live.at(id).data,"out-of-order or incorrect delivery");
   live.erase(id);order.pop_front();++received;
  }
  if(accept&&deliver)++simultaneous;
  peak=std::max(peak,unsigned(live.size()));need(live.size()<=N,"slot overflow");
 }
 dut.clock=1;dut.eval();Verilated::timeInc(1);return accept;
}
void idle(unsigned n=1){dut.io_valid=0;dut.auto_out_d_valid=0;while(n--)tick();}
void setup_request(){dut.io_valid=1;dut.io_addr=0x80000000ULL+sent*8;dut.io_mode=sent%3==0;dut.io_writeData=payload(sent);}
void submit(){setup_request();unsigned tries=0;while(!tick())need(++tries<50,"request never accepted");dut.io_valid=0;}
void respond(unsigned id){set_response(id,live.at(id).data);tick();dut.auto_out_d_valid=0;}
int main(int argc,char **argv){Verilated::commandArgs(argc,argv);
 try{
  dut.reset=1;dut.io_valid=0;dut.auto_out_d_valid=0;dut.auto_out_a_ready=1;dut.io_mask=255;tick();tick();dut.reset=0;idle();
  for(unsigned i=0;i<N;++i)submit();
  need(live.size()==N,"not all slots usable");dut.clock=0;dut.eval();need(dut.io_busy&&!dut.io_empty,"full/empty flags wrong");
  std::deque<unsigned> ids=order;unsigned before=received;
  for(unsigned i=N-1;i>0;--i){respond(ids[i]);idle(2);need(received==before,"younger response escaped");need(dut.io_busy,"source freed before ordered delivery");}
  respond(ids[0]);idle(N+2);need(live.empty(),"reverse burst did not drain");
  if(N>1){
   for(unsigned i=0;i<N;++i)submit();ids=order;respond(ids[0]);idle();submit();
   need(order.back()==ids[0]&&order.front()==ids[1],"source reuse setup failed");before=received;
   respond(ids[0]);idle(2);need(received==before,"numeric ID order used instead of issue order");
   for(unsigned i=N-1;i>0;--i)respond(ids[i]);idle(N+2);need(live.empty(),"reused source burst did not drain");
  }
  for(unsigned i=0;i<32;++i){setup_request();dut.auto_out_a_ready=1;dut.clock=0;dut.eval();need(dut.io_a_fire,"zero-latency setup stalled");
   unsigned id=@GET_SOURCE@;set_response(id,payload(sent));need(tick(),"zero-latency request lost");idle(3);need(live.empty(),"zero-latency response lost");}
  std::mt19937 rng(0x1a2b3c4d+N);unsigned goal=sent+2000;
  for(unsigned cycle=0;received<goal&&cycle<50000;++cycle){
   setup_request();dut.io_valid=sent<goal&&rng()%5!=0;dut.auto_out_a_ready=rng()%5!=0;dut.auto_out_d_valid=0;
   if(!order.empty()&&rng()%4!=0){int chosen=-1;
    if(rng()%4!=0){for(auto it=order.rbegin();it!=order.rend();++it)if(!live.at(*it).returned){chosen=*it;break;}}
    else{for(unsigned id:order)if(!live.at(id).returned){chosen=id;break;}}
    if(chosen>=0)set_response(chosen,live.at(chosen).data);
   }tick();
  }
  idle(3);dut.clock=0;dut.eval();need(sent==goal&&received==goal&&live.empty()&&dut.io_empty&&!dut.io_busy,"random stress did not drain");
  need(peak==N&&seen==((1U<<N)-1),"not all source IDs covered");need(N==1||reversed>0,"no out-of-order returns exercised");
  std::cout<<"DMA_PARAMETER_RTL_PASS ids="<<N<<" transactions="<<received<<" peak_reserved="<<peak<<" source_mask="<<seen<<" genuine_out_of_order_returns="<<reversed<<" simultaneous_issue_delivery="<<simultaneous<<" zero_latency=32\n";
  dut.final();return 0;
 }catch(const std::exception&e){std::cerr<<"DMA_PARAMETER_RTL_FAIL ids="<<N<<" reason="<<e.what()<<"\n";return 1;}
}

dma6_monitor.sv:
// Simulation-only observation. No signal driven back into the design.
module LumaxDma6Monitor(
  input clock, reset, a_fire, raw_valid, deliver,
  input [2:0] source, raw_source, oldest,
  input [2:0] opcode,
  input [31:0] address,
  input [5:0] occupied
);
  integer ids_seen, raw_live, raw_peak, reserved, reserved_peak;
  integer issued, returned_count, delivered_count, reorder_count;
  integer source_count[0:5], live_source[0:5], response_seen[0:5], source_case[0:5];
  integer fifo[0:5], head, tail, count;
  integer x_mask[0:2], x_live[0:2], x_peak[0:2], x_requests[0:2], x_returns[0:2];
  reg [63:0] x_base[0:2];
  integer x_bytes[0:2];
  integer i, j, idx, found, older_missing, sid, ignored;
  reg [63:0] base0,base1,base2;
  integer size0,size1,size2;
  initial begin
    if(!$value$plusargs("dma_x0_base=%h",base0))base0=0;
    if(!$value$plusargs("dma_x0_bytes=%d",size0))size0=0;
    x_base[0]=base0;x_bytes[0]=size0;
    $display("DMA6_RANGE case=0 base=%h bytes=%0d",base0,size0);
    if(!$value$plusargs("dma_x1_base=%h",base1))base1=0;
    if(!$value$plusargs("dma_x1_bytes=%d",size1))size1=0;
    x_base[1]=base1;x_bytes[1]=size1;
    $display("DMA6_RANGE case=1 base=%h bytes=%0d",base1,size1);
    if(!$value$plusargs("dma_x2_base=%h",base2))base2=0;
    if(!$value$plusargs("dma_x2_bytes=%d",size2))size2=0;
    x_base[2]=base2;x_bytes[2]=size2;
    $display("DMA6_RANGE case=2 base=%h bytes=%0d",base2,size2);
  end
  always @(posedge clock) begin
    if(reset)begin
      ids_seen=0;raw_live=0;raw_peak=0;reserved=0;reserved_peak=0;
      issued=0;returned_count=0;delivered_count=0;reorder_count=0;
      head=0;tail=0;count=0;
      for(i=0;i<6;i=i+1)begin source_count[i]=0;live_source[i]=0;response_seen[i]=0;source_case[i]=-1;end
      for(i=0;i<3;i=i+1)begin x_mask[i]=0;x_live[i]=0;x_peak[i]=0;x_requests[i]=0;x_returns[i]=0;end
    end else begin
      if(reserved!=$countones(occupied))$fatal(1,"DMA6 monitor occupancy mismatch");
      if(raw_valid)begin
        if(raw_source>=6)$fatal(1,"DMA6 illegal response ID");
        if(!live_source[raw_source] || response_seen[raw_source])$fatal(1,"DMA6 unexpected response");
        found=0;older_missing=0;
        for(j=0;j<count;j=j+1)begin
          sid=fifo[(head+j)%6];
          if(sid==raw_source)found=1;
          else if(!found && !response_seen[sid])older_missing=1;
        end
        if(older_missing)reorder_count=reorder_count+1;
        response_seen[raw_source]=1;
        raw_live=raw_live-1;returned_count=returned_count+1;
        idx=source_case[raw_source];
        if(idx>=0)begin x_live[idx]=x_live[idx]-1;x_returns[idx]=x_returns[idx]+1;end
      end
      if(deliver)begin
        if(count==0 || fifo[head]!=oldest || !response_seen[oldest])$fatal(1,"DMA6 incorrect ordered retirement");
        live_source[oldest]=0;response_seen[oldest]=0;
        head=(head+1)%6;count=count-1;reserved=reserved-1;delivered_count=delivered_count+1;
      end
      if(a_fire)begin
        if(source>=6 || live_source[source] || count>=6)$fatal(1,"DMA6 invalid source allocation");
        fifo[tail]=source;tail=(tail+1)%6;count=count+1;
        live_source[source]=1;response_seen[source]=0;source_case[source]=-1;
        ids_seen=ids_seen | (1<<source);source_count[source]=source_count[source]+1;
        raw_live=raw_live+1;reserved=reserved+1;issued=issued+1;
        if(opcode==4)begin
          for(j=0;j<3;j=j+1)begin
            if({32'd0,address}>=x_base[j] && {32'd0,address}<x_base[j]+x_bytes[j])begin
              source_case[source]=j;x_mask[j]=x_mask[j] | (1<<source);
              x_live[j]=x_live[j]+1;x_requests[j]=x_requests[j]+1;
            end
          end
        end
      end
      if(raw_live<0 || raw_live>6 || reserved<0 || reserved>6)$fatal(1,"DMA6 live request count outside limits");
      if(raw_live>raw_peak)raw_peak=raw_live;
      if(reserved>reserved_peak)reserved_peak=reserved;
      for(i=0;i<3;i=i+1)if(x_live[i]>x_peak[i])x_peak[i]=x_live[i];
    end
  end
  final begin
    $display("DMA6_TOTAL mask=%02x raw_peak=%0d reserved_peak=%0d issued=%0d returned=%0d delivered=%0d reordered=%0d pending=%0d",ids_seen,raw_peak,reserved_peak,issued,returned_count,delivered_count,reorder_count,reserved);
    for(integer n=0;n<6;n=n+1)$display("DMA6_ID id=%0d requests=%0d",n,source_count[n]);
    for(integer n=0;n<3;n=n+1)$display("DMA6_X case=%0d mask=%02x peak_raw=%0d requests=%0d returns=%0d pending=%0d",n,x_mask[n],x_peak[n],x_requests[n],x_returns[n],x_live[n]);
    if(raw_live!=0 || reserved!=0 || count!=0)$fatal(1,"DMA6 completed with pending requests");
  end
endmodule
bind DmaModule LumaxDma6Monitor dma6_monitor(
 .clock(clock),.reset(reset),.a_fire(io_a_fire),.raw_valid(auto_out_d_valid),.deliver(io_d_valid),
 .source(auto_out_a_bits_source),.raw_source(auto_out_d_bits_source),.oldest(_requestOrder_io_deq_bits),
 .opcode(auto_out_a_bits_opcode),.address(auto_out_a_bits_address),
 .occupied({outstanding_5,outstanding_4,outstanding_3,outstanding_2,outstanding_1,outstanding_0})
);

run.py:
import ast,concurrent.futures,fcntl,hashlib,json,os,random,re,resource,shlex,shutil,signal,struct,subprocess,sys,threading,time
from pathlib import Path
from datetime import datetime
sys.dont_write_bytecode=True;resource.setrlimit(resource.RLIMIT_CORE,(0,0))
root=Path('/home/kioannou/chipyard_1.13.0/generators/LUMAX');outer=Path(__file__).resolve().parent
sys.path.insert(0,str(root/'verification'))
import run_y_slice as runner
hw=runner.hw
logfile=root/'verification/logs/y_slice'/('run_'+datetime.now().strftime('%Y%m%d_%H%M%S_%f')+'.log')
(outer/'final_log_path').write_text(str(logfile));mutex=threading.Lock();records=[];dma_results=[];jobs=[]
def log(value):
 with mutex:
  with logfile.open('a') as f:f.write(str(value)+'\n')
  print(value if len(str(value))<1600 else str(value)[:220]+' ... [full data in log]',flush=True)
def command(cmd,cwd,out,env,timeout=1800):
 log('COMMAND: '+shlex.join(list(map(str,cmd))))
 with out.open('w') as f:
  proc=subprocess.Popen(list(map(str,cmd)),cwd=cwd,env=env,stdout=f,stderr=subprocess.STDOUT,start_new_session=True)
  try:return proc.wait(timeout)
  except BaseException:
   os.killpg(proc.pid,signal.SIGTERM)
   try:proc.wait(5)
   except subprocess.TimeoutExpired:os.killpg(proc.pid,signal.SIGKILL);proc.wait()
   raise
ns=dict(runner=runner,random=random,struct=struct,hashlib=hashlib,json=json)
tree=ast.parse((outer/'old_test_helpers.py').read_text())
exec(compile(ast.Module(body=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in ('make_cases','operand_summary')],type_ignores=[]),'previous exact vectors','exec'),ns)
make_cases=ns['make_cases'];operand_summary=ns['operand_summary']
env=hw.environment();runtime=outer/'runtime';runtime.mkdir();env['XDG_RUNTIME_DIR']=str(runtime)
env['SBT_OPTS']=(env.get('SBT_OPTS') or f'-Dsbt.ivy.home={hw.CY}/.ivy2 -Dsbt.global.base={hw.CY}/.sbt -Dsbt.boot.directory={hw.CY}/.sbt/boot/')+' -Dsbt.server.forcestart=true -Dsbt.server.autostart=false -Dsbt.supershell=false'
base=(hw.SRC/'Linear-sw.c').read_text()
log('DMA PARAMETER AND ACTIVATION-COUNT FIX — actual make/RISC-V/Verilator')
log('LOG: '+str(logfile)+'\nWORK: '+str(outer))
log('Cin256 Cout32 Rin4 b8_rf8 Y_SLICE2. No Cout capacity workaround. Production counter now follows Cin. Source width max(1,ceil(log2(ID))).')
for name in ['DMA.scala','LUMAX_Top.scala']:log(name+' SHA256='+hw.sha(root/'src/main/scala'/name))

def build(ids,floating=False,full=False):
 label=('fp16' if floating else 'int16')+f'_ids{ids}';folder=outer/label;folder.mkdir();text=original.decode()
 for key,value in dict(Dma_Ids=ids,Rin=4,Cin=256,Cout=32,x_slice=8,Mem_row_factor=8,y_slice=2,FP16_ACTIVATIONS=str(floating).lower()).items():
  text,count=re.subn(r'(?m)^(\s*'+key+r'\s*=\s*)(?:\d+|true|false)',lambda m:m[1]+str(value),text);assert count==1,key
 snapshot=folder/'Config.scala';snapshot.write_text(text);sim=folder/'simulator-LUMAXROcketConfig'
 common=['make','-j8','CONFIG=LUMAXROcketConfig','sim='+str(sim),'gen_dir='+str(folder/'generated-src')]
 try:
  hw.CONFIG.write_text(text)
  code=command([*common,'verilog'],hw.CY/'sims/verilator',folder/'elaboration.log',env,7200)
  if code:raise RuntimeError((folder/'elaboration.log').read_text()[-5000:])
  collateral=next((folder/'generated-src').glob('*/gen-collateral'))
  top=(collateral/'LUMAXExample.sv').read_text();assert re.search(r'reg\s+\[8:0\]\s+all_available_elems_x\s*;',top),'activation count not 9 bits'
  log(f'ELABORATION PASS {label}; actual activation counter width=9 for Cin256/Cout32; DMA slots={ids}')
  if full:
   extra=[]
   if ids==6:
    mon=folder/'generated-src/dma6_monitor.sv';mon.write_bytes((outer/'dma6_monitor.sv').read_bytes());extra=['EXTRA_SIM_SOURCES='+str(mon),'EXTRA_SIM_REQS='+str(mon)]
   code=command([*common,*extra],hw.CY/'sims/verilator',folder/'make.log',env,7200)
   if code:raise RuntimeError((folder/'make.log').read_text()[-5000:])
   log('MAKE SIMULATOR PASS '+label+' SHA256='+hw.sha(sim))
 finally:
  if hw.CONFIG.read_bytes()==text.encode():hw.CONFIG.write_bytes(original)
  elif hw.CONFIG.read_bytes()!=original:raise RuntimeError('External configuration changed')
 return folder,sim,snapshot,collateral

def direct_test(ids,folder,collateral):
 test=folder/'dma_direct';test.mkdir();dma=collateral/'DmaModule.sv';dma_text=dma.read_text();ports=dma_text.split(');',1)[0]
 source=(outer/'dma_test.cpp.in').read_text().replace('@N@',str(ids))
 source=source.replace('@GET_SOURCE@','dut.auto_out_a_bits_source' if 'auto_out_a_bits_source' in ports else '0U')
 source=source.replace('@READ_SOURCE@','dut.auto_out_d_bits_source' if 'auto_out_d_bits_source' in ports else '0U')
 source=source.replace('@SET_SOURCE@','dut.auto_out_d_bits_source=id;' if 'auto_out_d_bits_source' in ports else 'need(id==0,"unexpected source");')
 (test/'dma_test.cpp').write_text(source)
 # Include only dependencies of the emitted production DMA module.
 files=[];todo=[dma];seen=set()
 while todo:
  path=todo.pop()
  if path in seen:continue
  seen.add(path);files.append(path)
  for kind in re.findall(r'(?m)^  (\w+)\s+\w+\s*\(',path.read_text()):
   child=collateral/(kind+'.sv')
   if child.exists():todo.append(child)
 cmd=[hw.CY/'.conda-env/bin/verilator','--cc','--exe','--build','--assert','-Wno-fatal','-j','4','--top-module','DmaModule','--Mdir',test/'obj',*files,test/'dma_test.cpp']
 code=command(cmd,test,test/'compile.log',env,180)
 if code:raise RuntimeError((test/'compile.log').read_text()[-6000:])
 code=command([test/'obj/VDmaModule'],test,test/'result.log',env,20)
 result=(test/'result.log').read_text();log(result)
 if code or f'DMA_PARAMETER_RTL_PASS ids={ids} ' not in result:raise RuntimeError('DMA RTL verification failed')
 dma_results.append(dict(ids=ids,result=result,source_sha256=hw.sha(test/'dma_test.cpp'),rtl_sha256=hw.sha(dma)))


def compile_case(folder,snapshot,tests,floating,wb,label,exact=False):
 case=folder/label;case.mkdir();text=runner.source(base,tests,wb,floating,2,8,8,False)
 text,count=re.subn(r'(?m)^ matmul_sw_uniform\(sw,&tx,&tw,\d+,\d+,\d+\);$',' /* Numerical verification is performed by independent host Python. */',text);assert count==len(tests)
 text,count=re.subn(r'(?m)^ int same=!memcmp\(out,sw,\d+\*4\);$',' int same=1; /* HW_DONE: the hardware call completed, not a numerical claim. */',text);assert count==len(tests)
 text=text.replace('C_MATCH %d','HW_DONE %d').replace('failed|=!same||!safe;','failed|=!safe;')
 if not exact:
  for i,t in enumerate(tests):
   n=t['r']*t['m']
   old=f' printf("HW {i} ");for(int j=0;j<{n};j++)printf("%08x ",(uint32_t)out[j]);printf("\\n");fflush(stdout);'
   new=f''' char hex[{n*9+1}];static const char digits[]="0123456789abcdef";
 for(int j=0;j<{n};j++){{uint32_t v=(uint32_t)out[j];for(int q=0;q<8;q++)hex[j*9+q]=digits[(v>>(28-q*4))&15];hex[j*9+8]=' ';}}
 hex[{n*9}]=0;printf("HW {i} %s\\n",hex);fflush(stdout);'''
   assert text.count(old)==1;text=text.replace(old,new,1)
 (case/'Linear-sw.c').write_text(text)
 for name in ['build.sh','rocc.h','compiler.h']:shutil.copy2(hw.SRC/name,case/name)
 case_env=dict(env,LUMAX_CONFIG_PATH=str(snapshot),TEST_CFLAGS=f'-O2 -DLUMAX_FP16_ACTIVATIONS={int(floating)}')
 code=command(['bash','./build.sh','baremetal'],case,case/'compile.log',case_env,600)
 if code:raise RuntimeError((case/'compile.log').read_text())
 elf=case/'Linear-sw.riscv'
 if exact:
  assert hw.sha(elf)=='e73496077a5abb7d5253dc0720a47bb2a450a316e732acc6ac2de892efcb27f0','Exact old ELF did not match'
  log('EXACT ORIGINAL FAILING ELF VERIFIED SHA256='+hw.sha(elf))
 log('C SHA256='+hw.sha(case/'Linear-sw.c')+' ELF SHA256='+hw.sha(elf)+'; only input/weight vectors embedded; no Python answers')
 return case,elf

def native_run(ids,folder,sim,tests,floating,wb,label,case,elf):
 nm=subprocess.check_output(['riscv64-unknown-elf-nm','-S',str(elf)],env=env,text=True);args=[]
 for i,t in enumerate(tests):
  m=re.search(r'(?m)^([0-9a-fA-F]+)\s+[0-9a-fA-F]+\s+\w\s+x'+str(i)+r'$',nm);assert m
  args += [f'+dma_x{i}_base={int(m[1],16)+8:x}',f'+dma_x{i}_bytes={t["r"]*t["k"]*2}']
 code=command([sim,'+permissive','+max-cycles=1000000000',*args,'+loadmem='+str(elf),'+permissive-off',elf],case,case/'uart.log',env,1800)
 uart=(case/'uart.log').read_text(errors='replace');log('UART '+folder.name+'/'+label+'\n'+uart)
 actuals={int(i):[int(v,16) for v in data.split()] for i,data in re.findall(r'^HW (\d+) (.*)$',uart,re.M)}
 flags={int(i):(int(g),int(done),int(core),list(map(int,pc.split()))) for i,g,done,core,pc in re.findall(r'^RESULT (\d+) GUARDS (\d) HW_DONE (\d) CORE (\d+) PC ((?:\d+ ){5}\d+)$',uart,re.M)}
 cov={int(i):dict(mask=int(mask,16),peak_raw=int(peak),requests=int(req),returns=int(ret),pending=int(pending)) for i,mask,peak,req,ret,pending in re.findall(r'^DMA6_X case=(\d+) mask=([0-9a-fA-F]+) peak_raw=(\d+) requests=(\d+) returns=(\d+) pending=(\d+)$',uart,re.M)}
 complete=code==0 and uart.splitlines().count('TEST_DONE 0')==1 and len(actuals)==len(tests)
 for i,t in enumerate(tests):
  guard,done,core,pc=flags.get(i,(0,0,0,[0]*6));actual=actuals.get(i,[])
  coverage_ok=ids!=6 or (i in cov and cov[i]['mask']==63 and cov[i]['peak_raw']==6 and cov[i]['requests']==cov[i]['returns'] and cov[i]['pending']==0)
  good=complete and guard==done==1 and actual==t['expected'] and core>0 and coverage_ok
  r=dict(ids=ids,mode='FP16' if floating else 'INT16',wb=wb,label=label,case=t['name'],shape=[t['r'],t['k'],t['m']],physical_Cin=256,physical_Cout=32,b=8,rf=8,ys=2,status='PASS' if good else 'FAIL',hw=actual,python=t['expected'],core=core,pc=pc,coverage=cov.get(i),seed=t['seed'])
  log('OPERAND STATISTICS: '+operand_summary(t));log('MATRIX RESULT: '+json.dumps(r,sort_keys=True))
  with mutex:records.append(r)
 if not complete:raise RuntimeError('RISC-V simulator execution incomplete or failed')

pool=concurrent.futures.ThreadPoolExecutor(max_workers=3)
try:
 with hw.CONFIG.open('rb') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB);original=hw.CONFIG.read_bytes()
  folder,sim,snapshot,collateral=build(6,False,True)
  direct_test(6,folder,collateral)
  for wb in (8,4,2):
   tests=make_cases(wb,False,2);label=f'python_w{wb}';case,elf=compile_case(folder,snapshot,tests,False,wb,label)
   jobs.append(pool.submit(native_run,6,folder,sim,tests,False,wb,label,case,elf))
  tests=make_cases(8,False,2);case,elf=compile_case(folder,snapshot,tests,False,8,'exact_pre_fix_w8',True)
  jobs.append(pool.submit(native_run,6,folder,sim,tests,False,8,'exact_pre_fix_w8',case,elf))
  folder,sim,snapshot,collateral=build(6,True,True)
  for wb in (8,4,2):
   tests=make_cases(wb,True,2);label=f'python_w{wb}';case,elf=compile_case(folder,snapshot,tests,True,wb,label)
   jobs.append(pool.submit(native_run,6,folder,sim,tests,True,wb,label,case,elf))
  for ids in (1,2,3,4,8):
   folder,sim,snapshot,collateral=build(ids,False,False);direct_test(ids,folder,collateral)
  assert hw.CONFIG.read_bytes()==original
 for job in jobs:job.result()
finally:pool.shutdown(wait=True,cancel_futures=True)
(outer/'matrix_results.json').write_text(json.dumps(records));(outer/'dma_results.json').write_text(json.dumps(dma_results))
failed=sum(r['status']!='PASS' for r in records)
log('FINAL MATRIX TOTAL: '+json.dumps(dict(PASS=len(records)-failed,FAIL=failed)))
log('DMA SOURCE COUNTS VERIFIED: '+str(sorted(r['ids'] for r in dma_results)))
raise SystemExit(int(failed>0))

final_run.py:
import ast,concurrent.futures,fcntl,hashlib,json,os,random,re,resource,shlex,shutil,signal,struct,subprocess,sys,threading,time
from pathlib import Path
from datetime import datetime
sys.dont_write_bytecode=True;resource.setrlimit(resource.RLIMIT_CORE,(0,0))
root=Path('/home/kioannou/chipyard_1.13.0/generators/LUMAX');parent=Path(__file__).resolve().parent
sys.path.insert(0,str(root/'verification'))
import run_y_slice as runner
hw=runner.hw;outer=parent/'final';outer.mkdir();mutex=threading.Lock();records=[];dma_results=[];jobs=[]
logfile=Path((parent/'final_log_path').read_text())
for name in ['dma6_monitor.sv','dma_test.cpp.in','old_test_helpers.py']:shutil.copy2(parent/name,outer/name)
# Reuse orchestrator definitions only; don't restart the incomplete first sweep.
tree=ast.parse((parent/'run.py').read_text())
functions=[n for n in tree.body if isinstance(n,ast.FunctionDef)]
exec(compile(ast.Module(body=functions,type_ignores=[]),'<final hardware verification helpers>','exec'),globals())
print('Waiting for the previous build boundary before completing the K-index width fix.',flush=True)
with hw.CONFIG.open('rb') as lock:
 while True:
  try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB);break
  except BlockingIOError:time.sleep(0.5)
 original=hw.CONFIG.read_bytes()
 p=root/'src/main/scala/LUMAX_Top.scala';text=p.read_text()
 old='  val j_x_start     = RegInit(0.U(log2Ceil(params.Cout + 1).W)) '
 new='  val j_x_start     = RegInit(0.U(log2Ceil(params.Cin + 1).W)) // Activation K-block offset.'
 assert text.count(old)==1;text=text.replace(old,new,1)
 old='  val cin_reg               = RegInit(params.Cout.U(log2Ceil(params.Cin + 1).W))'
 new='  val cin_reg               = RegInit(params.Cin.U(log2Ceil(params.Cin + 1).W))'
 assert text.count(old)==1;p.write_text(text.replace(old,new,1))
 log('\nFINAL SOURCE REVISION: both activation count and K-block start follow Cin, and cin_reg resets to params.Cin. The incomplete first revision widened only the count; its W8 failures are retained above. Python repeating the first64 activation elements reproduces those failed outputs exactly, confirming the wrapped K-block start. Previous sweep stopped at an owned temporary build-directory boundary; no active simulator was interrupted.')
 for name in ['DMA.scala','LUMAX_Top.scala']:log('FINAL '+name+' SHA256='+hw.sha(root/'src/main/scala'/name))
 env=hw.environment();runtime=outer/'runtime';runtime.mkdir();env['XDG_RUNTIME_DIR']=str(runtime)
