DIRECT DMA RTL TEST SOURCE (temporary file removed after this log was saved):
#include "VDmaModule.h"
#include "verilated.h"
#include <algorithm>
#include <cstdint>
#include <cstdlib>
#include <deque>
#include <iostream>
#include <map>
#include <random>
#include <stdexcept>
struct Entry { uint64_t data; bool responded=false; };
VDmaModule dut;
std::map<unsigned,Entry> live;
std::deque<unsigned> order;
unsigned sent=0,received=0,peak=0,reversed=0,simultaneous=0;
uint64_t payload(unsigned n) {return 0x1234000000000000ULL | (uint64_t(n)<<8) | (n%3==0);}
void need(bool ok,const char *why){if(!ok)throw std::runtime_error(why);}
bool tick(){
 dut.clock=0;dut.eval();
 bool accepted=dut.io_a_fire,delivered=dut.io_d_valid;
 if(!dut.reset){
  if(dut.auto_out_d_valid){
   unsigned id=dut.auto_out_d_bits_source;
   need(live.count(id) && !live.at(id).responded,"invalid generated response");
   need(dut.auto_out_d_bits_data==live.at(id).data,"test response data mismatch");
   if(order.front()!=id)++reversed;
   live.at(id).responded=true;
  }
  if(delivered){
   need(!order.empty(),"unexpected delivery");unsigned id=order.front();
   need(live.at(id).responded,"response delivered before memory returned it");
   need(dut.io_readData==live.at(id).data,"DMA delivered a response out of order");
   order.pop_front();live.erase(id);++received;
  }
  if(accepted){
   unsigned id=dut.auto_out_a_bits_source;
   need(!live.count(id),"source reused before ordered delivery");
   need(dut.auto_out_a_bits_address==dut.io_addr,"wrong address");
   need(dut.auto_out_a_bits_opcode==(dut.io_mode==0?4:1),"wrong Get/Put opcode");
   live[id]={payload(sent),false};order.push_back(id);++sent;
  }
  if(accepted&&delivered)++simultaneous;
  peak=std::max(peak,unsigned(live.size()));
  need(live.size()<=2,"more than two occupied slots");
 }
 dut.clock=1;dut.eval();Verilated::timeInc(1);
 return accepted;
}
void idle(unsigned n=1){dut.io_valid=0;dut.auto_out_d_valid=0;while(n--)tick();}
void submit(){
 dut.io_valid=1;dut.io_addr=0x80000000ULL+sent*8;dut.io_mode=(sent%3==0);dut.io_writeData=payload(sent);
 unsigned tries=0;while(!tick())need(++tries<50,"request never accepted");dut.io_valid=0;
}
void respond(unsigned id){
 dut.auto_out_d_valid=1;dut.auto_out_d_bits_source=id;dut.auto_out_d_bits_data=live.at(id).data;tick();dut.auto_out_d_valid=0;
}
int main(int argc,char**argv){
 Verilated::commandArgs(argc,argv);
 try{
  dut.reset=1;dut.io_valid=0;dut.auto_out_d_valid=0;dut.auto_out_a_ready=1;dut.io_mask=255;tick();tick();dut.reset=0;idle();
  // Two requests accepted BEFORE any response: prove concurrency is retained.
  submit();submit();need(live.size()==2,"two concurrent requests unavailable");
  dut.clock=0;dut.eval();need(dut.io_busy&&!dut.io_empty,"full DMA flags wrong");
  unsigned a=order[0],b=order[1],before=received;
  respond(b);idle(3);need(received==before,"younger response escaped before oldest");
  respond(a);idle(3);need(live.empty(),"reverse pair did not drain");
  // Reuse source 0 while source 1 is older. Request order must not be ID order.
  submit();submit();a=order[0];b=order[1];respond(a);idle();
  need(order.size()==1,"first response did not retire");submit();
  need(order[0]==b && order[1]==a,"source reuse test setup failed");before=received;
  respond(a);idle(2);need(received==before,"numeric source order used instead of request order");
  respond(b);idle(3);need(live.empty(),"reused-ID pair did not drain");
  std::mt19937 rng(0x1a2b3c4d);
  for(unsigned cycle=0;received<1005 && cycle<30000;++cycle){
   dut.io_valid=sent<1005 && rng()%5!=0;
   dut.io_addr=0x80000000ULL+sent*8;dut.io_mode=(sent%3==0);dut.io_writeData=payload(sent);
   dut.auto_out_a_ready=rng()%5!=0;dut.auto_out_d_valid=0;
   if(!order.empty() && rng()%4!=0){
    int chosen=-1;
    if(rng()%4!=0){for(auto it=order.rbegin();it!=order.rend();++it)if(!live.at(*it).responded){chosen=*it;break;}}
    else{for(unsigned id:order)if(!live.at(id).responded){chosen=id;break;}}
    if(chosen>=0){dut.auto_out_d_valid=1;dut.auto_out_d_bits_source=chosen;dut.auto_out_d_bits_data=live.at(chosen).data;}
   }
   tick();
  }
  idle(3);dut.clock=0;dut.eval();
  need(sent==1005&&received==1005&&live.empty()&&dut.io_empty&&!dut.io_busy,"random stress did not drain");
  need(reversed>0&&peak==2&&simultaneous>0,"required scenarios not exercised");
  std::cout<<"DIRECT GENERATED DMA RTL PASS: transactions="<<received<<" peak_occupied="<<peak<<" out_of_order_returns="<<reversed<<" simultaneous_issue_delivery="<<simultaneous<<"; reversed pairs, source reuse, mixed Get/Put, request stalls and drain verified.\n";
  dut.final();return 0;
 }catch(const std::exception&e){std::cerr<<"DIRECT DMA RTL FAIL: "<<e.what()<<"\n";return 1;}
}

