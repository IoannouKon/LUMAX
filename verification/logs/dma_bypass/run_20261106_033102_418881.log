#include "VDmaModule.h"
#include "verilated.h"
#include <algorithm>
#include <cstdint>
#include <deque>
#include <iostream>
#include <random>
#include <stdexcept>
#include <vector>

struct Entry { unsigned id; uint64_t value; bool arrived=false, corrupt=false, denied=false; };
struct Check {
  VDmaModule dut;
  std::deque<Entry> order;
  bool bypass;
  uint64_t issued=0, retired=0, fast=0, buffered=0, cycles=0;
  explicit Check(bool mode):bypass(mode) {
    dut.clock=0;dut.reset=1;dut.io_valid=0;dut.auto_out_a_ready=1;
    dut.auto_out_d_valid=0;dut.auto_out_d_bits_source=0;dut.auto_out_d_bits_data=0;
    dut.auto_out_d_bits_opcode=1;dut.auto_out_d_bits_param=0;dut.auto_out_d_bits_size=3;
    dut.auto_out_d_bits_sink=0;dut.auto_out_d_bits_corrupt=0;dut.auto_out_d_bits_denied=0;
    dut.io_addr=0;dut.io_log_S=3;dut.io_mode=0;dut.io_mask=255;dut.io_writeData=0;dut.io_d_ready=0;
    for(int i=0;i<3;i++)tick();dut.reset=0;dut.eval();
  }
  void need(bool ok,const char *what) {if(!ok)throw std::runtime_error(std::string(what)+" at cycle "+std::to_string(cycles));}
  void tick(){dut.clock=0;dut.eval();dut.clock=1;dut.eval();dut.clock=0;dut.eval();cycles++;}
  Entry make(unsigned id) {return Entry{id,UINT64_C(0x1234000000000000)+issued+1,false,bool((issued+1)&1),bool((issued+1)&2)};}
  unsigned freeid(){for(unsigned i=0;i<6;i++)if(std::none_of(order.begin(),order.end(),[&](const Entry&e){return e.id==i;}))return i;return 0;}
  void step(bool request=false,bool a_ready=true,int reply=-1,bool fresh=false) {
    unsigned source=freeid();Entry fresh_entry=make(source);Entry response{};
    if(reply>=0) {
      auto it=std::find_if(order.begin(),order.end(),[&](const Entry&e){return e.id==unsigned(reply);});
      if(it==order.end()){need(fresh&&request&&unsigned(reply)==source,"unexpected test reply");response=fresh_entry;}
      else {need(!it->arrived,"duplicate test reply");response=*it;}
    }
    dut.io_valid=request;dut.auto_out_a_ready=a_ready;dut.io_mode=(issued&1)?1:0;
    dut.io_addr=0x80000000+issued*8;dut.io_mask=(issued&1)?15:255;dut.io_writeData=0x76540000+issued;
    dut.auto_out_d_valid=reply>=0;dut.auto_out_d_bits_source=reply>=0?unsigned(reply):0;
    dut.auto_out_d_bits_data=response.value;dut.auto_out_d_bits_corrupt=response.corrupt;dut.auto_out_d_bits_denied=response.denied;
    dut.eval();
    bool expected_a=request&&a_ready&&order.size()<6;
    bool direct=!order.empty()&&!order.front().arrived&&reply>=0&&unsigned(reply)==order.front().id&&bypass;
    bool expected_d=!order.empty()&&(order.front().arrived||direct);
    need(bool(dut.io_busy)==(order.size()==6),"DMA capacity disagrees with ledger");
    need(bool(dut.io_a_fire)==expected_a,"A acceptance mismatch");
    need(bool(dut.io_d_valid)==expected_d,"D validity/order mismatch");
    need(dut.auto_out_d_ready,"D response unexpectedly backpressured");
    if(expected_a){
      need(dut.auto_out_a_bits_source==source,"source reservation/reuse mismatch");
      need(dut.auto_out_a_bits_address==dut.io_addr,"request address changed");
      need(dut.auto_out_a_bits_mask==dut.io_mask,"request mask changed");
      if(dut.io_mode)need(dut.auto_out_a_bits_data==dut.io_writeData,"request write data changed");
    }
    if(expected_d){
      Entry wanted=order.front();
      need(dut.io_tag==wanted.id,"retired tag mismatch");
      need(dut.io_readData==wanted.value,"response data mismatch");
      need(bool(dut.io_d_cor)==wanted.corrupt,"corrupt flag mismatch");
      need(bool(dut.io_d_den)==wanted.denied,"denied flag mismatch");
      if(direct)fast++;else buffered++;
    }
    if(reply>=0){
      auto it=std::find_if(order.begin(),order.end(),[&](const Entry&e){return e.id==unsigned(reply);});
      if(it!=order.end())it->arrived=true;else {need(expected_a,"fresh response without accepted A");fresh_entry.arrived=true;}
    }
    if(expected_d){order.pop_front();retired++;}
    if(expected_a){order.push_back(fresh_entry);issued++;}
    tick();
    need(bool(dut.io_empty)==order.empty(),"DMA empty mismatch");
  }
  std::vector<unsigned> pending(){std::vector<unsigned> ids;for(const auto&e:order)if(!e.arrived)ids.push_back(e.id);return ids;}
  void drain(){while(!order.empty()){auto p=pending();step(false,true,p.empty()?-1:int(p.back()));}step();}
  void done(const char*name){drain();std::cout<<"PASS "<<name<<" issued="<<issued<<" retired="<<retired<<" fast="<<fast<<" buffered="<<buffered<<"\n";}
};
int main(int argc,char **argv){
  Verilated::commandArgs(argc,argv);bool bypass=argc>1&&std::string(argv[1])=="bypass";
  try {
    {Check t(bypass);t.step(true);t.step(false,true,0);t.done("single_response_and_no_duplicate");}
    {Check t(bypass);t.step(true);t.step(true);t.step(false,true,1);t.step(false,true,0);t.done("out_of_order_then_head_response");}
    {Check t(bypass);t.step(true);t.step(true);t.step(true);t.step(false,true,1);t.step(false,true,0);t.step(false,true,2);t.done("buffered_delivery_with_concurrent_later_arrival");}
    {Check t(bypass);for(int i=0;i<6;i++)t.step(true);t.step(true,true,0);t.step(true,true,1);t.done("full_capacity_and_next_cycle_source_reuse");}
    {Check t(bypass);t.step(true,true,0,true);t.done("empty_queue_same_cycle_new_request_response");}
    {Check t(bypass);std::mt19937 rng(20261106);for(int i=0;i<2000;i++){auto p=t.pending();int reply=!p.empty()&&(rng()%4!=0)?int(p[rng()%p.size()]):-1;t.step(rng()%4!=0,rng()%5!=0,reply);}t.done("random_requests_responses_A_backpressure_flags_and_reuse");if(bypass)t.need(t.fast>0&&t.buffered>0,"random coverage missing a delivery path");}
    std::cout<<"TOTAL: 6/6 generated-RTL protocol checks PASS; mode="<<(bypass?"bypass":"baseline")<<"\n";
  }catch(const std::exception&e){std::cerr<<"FAIL "<<e.what()<<"\n";return 1;}
  return 0;
}

