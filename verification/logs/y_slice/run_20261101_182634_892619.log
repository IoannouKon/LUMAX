"""Temporary real-HW counter boundary tests; no production scripts modified."""
import fcntl, hashlib, json, os, re, secrets, shlex, shutil, signal, subprocess, sys, time
from datetime import datetime
from pathlib import Path
root=Path('/home/kioannou/chipyard_1.13.0/generators/LUMAX')
sys.dont_write_bytecode=True
sys.path.insert(0,str(root/'verification'))
import run_y_slice as y
hw=y.hw
work=Path(__file__).resolve().parent/'edges'
work.mkdir(exist_ok=True)
logfile=root/'verification/logs/y_slice'/('run_'+datetime.now().strftime('%Y%m%d_%H%M%S_%f')+'.log')
def log(value):
    with logfile.open('a') as f:f.write(str(value)+'\n')
    print(value,flush=True)
def command(cmd,cwd,output,env,timeout=3600):
    log('COMMAND: '+shlex.join(list(map(str,cmd))))
    with output.open('w') as f:
        p=subprocess.Popen(cmd,cwd=cwd,env=env,stdout=f,stderr=subprocess.STDOUT,start_new_session=True)
        try:code=p.wait(timeout)
        except BaseException:
            os.killpg(p.pid,signal.SIGTERM)
            try:p.wait(5)
            except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait()
            raise
    if code:raise RuntimeError(str(output)+'\n'+output.read_text(errors='replace')[-5000:])
def cases(wb,floating):
    rng=hw.RandomValues(secrets.randbits(64))
    result=[]
    for name,r,k,m in [('tiny_K1',3,1,3),('short_K3',4,3,3),('activation_word_and_tail',4,17,3),('multiple_words',2,65,5),('weight_word_wrap',4,264,3),('zero_after_large',4,33,3)]:
        x=([0]*(r*k) if name.startswith('zero') else
           [([0x3c00,0xbc00,0x3555,0x0400,1,0x8001,0x7bff,0][rng.value(16)&7] if floating else rng.value(16)) for _ in range(r*k)])
        w=[rng.value(wb) for _ in range(k*m)]
        expected=sum((y.fp.reference(x[row*k:(row+1)*k],w,m,floating) for row in range(r)),[])
        result.append(dict(name=name,r=r,k=k,m=m,x=x,w=w,block=min(k,8*8*(1<<(8-wb))),expected=expected))
    result.append(dict(result[0],name='tiny_repeat_after_large'))
    return result

log('COUNTER BOUNDARY VERIFICATION: actual make-built b8_rf8 Y_SLICE=2 DMA IDs=6, INT16/FP16, W8/W4/W2. Consecutive calls use the original Linear-sw.c RoCC helpers; no reference outputs embedded in ELF.')
log('LOG: '+str(logfile))
log('SOURCE SHA256: '+json.dumps({str(p):hw.sha(p) for p in sorted((root/'src/main/scala').glob('*.scala')) if p!=hw.CONFIG},sort_keys=True))
env=hw.environment()
runtime=work/'runtime';runtime.mkdir(exist_ok=True);env['XDG_RUNTIME_DIR']=str(runtime)
env['SBT_OPTS']=(env.get('SBT_OPTS') or f'-Dsbt.ivy.home={hw.CY}/.ivy2 -Dsbt.global.base={hw.CY}/.sbt -Dsbt.boot.directory={hw.CY}/.sbt/boot/')+' -Dsbt.server.forcestart=true -Dsbt.server.autostart=false -Dsbt.supershell=false'
base=(hw.SRC/'Linear-sw.c').read_text();results=[]
with hw.CONFIG.open('rb') as lock:
    log('Waiting for the existing row-regression configuration lock before any build.')
    fcntl.flock(lock,fcntl.LOCK_EX)
    original=hw.CONFIG.read_bytes()
    for floating in [False,True]:
        label='fp16' if floating else 'int16';folder=work/label;folder.mkdir(exist_ok=True)
        text=original.decode()
        for key,value in dict(Rin=8,Cin=512,Cout=16,x_slice=8,Mem_row_factor=8,y_slice=2,Dma_Ids=6,FP16_ACTIVATIONS=str(floating).lower()).items():
            text,count=re.subn(r'(?m)^(\s*'+key+r'\s*=\s*)(?:\d+|true|false)',lambda m:m[1]+str(value),text)
            assert count==1,key
        snapshot=folder/'Config.scala';snapshot.write_text(text)
        log('CONFIG: '+text)
        sim=folder/'simulator-LUMAXROcketConfig'
        try:
            hw.CONFIG.write_text(text)
            command(['make','-j8','CONFIG=LUMAXROcketConfig','sim='+str(sim),'gen_dir='+str(folder/'generated-src')],hw.CY/'sims/verilator',folder/'make.log',env,7200)
        finally:
            if hw.CONFIG.read_bytes()==text.encode():hw.CONFIG.write_bytes(original)
            elif hw.CONFIG.read_bytes()!=original:raise RuntimeError('External Config edit; not overwritten')
        log('MAKE PASS '+label+' SIMULATOR_SHA256='+hw.sha(sim))
        for wb in (8,4,2):
            tests=cases(wb,floating);case=folder/f'w{wb}';case.mkdir(exist_ok=True)
            (case/'Linear-sw.c').write_text(y.source(base,tests,wb,floating,2,8,8,True))
            for name in ['build.sh','rocc.h','compiler.h']:shutil.copy2(hw.SRC/name,case/name)
            caseenv=dict(env,LUMAX_CONFIG_PATH=str(snapshot),TEST_CFLAGS=f'-O2 -DLUMAX_FP16_ACTIVATIONS={int(floating)}')
            command(['bash','./build.sh','baremetal'],case,case/'build.log',caseenv,600)
            elf=case/'Linear-sw.riscv';log('ELF_SHA256='+hw.sha(elf)+'; no Python reference outputs embedded')
            command([str(sim),'+permissive','+max-cycles=1000000000','+loadmem='+str(elf),'+permissive-off',str(elf)],case,case/'uart.log',caseenv,1800)
            uart=(case/'uart.log').read_text(errors='replace');log('UART\n'+uart)
            outputs={int(i):[int(v,16) for v in data.split()] for i,data in re.findall(r'^HW (\d+) (.*)$',uart,re.M)}
            flags={int(i):(int(g),int(c),int(core)) for i,g,c,core in re.findall(r'^RESULT (\d+) GUARDS (\d) C_MATCH (\d) CORE (\d+)',uart,re.M)}
            assert uart.splitlines().count('TEST_DONE 0')==1 and len(outputs)==len(flags)==len(tests)
            for i,t in enumerate(tests):
                guards,match,core=flags[i];actual=outputs[i]
                record=dict(mode=label.upper(),y_slice=2,b=8,rf=8,dma_ids=6,wb=wb,case=t['name'],shape=[t['r'],t['k'],t['m']],block=t['block'],status='PASS' if actual==t['expected'] and guards==match==1 and core>0 else 'FAIL',core=core,hw=actual,python=t['expected'])
                log('OPERANDS: '+json.dumps(dict(X=t['x'],W=t['w'])))
                log('CASE RESULT: '+json.dumps(record,sort_keys=True));results.append(record)
                assert record['status']=='PASS',record
    assert hw.CONFIG.read_bytes()==original
log('TOTAL: '+json.dumps(dict(tests=len(results),passed=sum(r['status']=='PASS' for r in results),failed=sum(r['status']!='PASS' for r in results),matched_outputs=sum(len(r['hw']) for r in results))))
log('Config restored. Temporary test sources, generated RTL and executables will be removed after direct counter RTL checks.')
