#include "VActivationAddressCounter.h"
#include "verilated.h"
#include <cstdint>
#include <iostream>
#include <stdexcept>

int main(int argc, char **argv) {
  Verilated::commandArgs(argc, argv);
  const unsigned banks = argc > 1 ? std::stoul(argv[1]) : 2;
  const unsigned maxBlocks = argc > 2 ? std::stoul(argv[2]) : 256;
  VActivationAddressCounter d;
  auto tick = [&]() { d.clock=0;d.eval();d.clock=1;d.eval();d.clock=0;d.eval(); };
  d.reset=1;d.io_restart=0;d.io_advance=0;tick();d.reset=0;
  uint64_t checked=0;
  uint32_t random=1729381;
  for (unsigned packed : {1u,2u}) {
    for (unsigned blocks=1;blocks<=maxBlocks;blocks++) {
      for (unsigned dirty=0;dirty<8;dirty++) {
        d.io_blocks=blocks;d.io_elementsPerCell=packed;d.io_startOffset=dirty;
        // Restart must win even when advance is also asserted.
        d.io_restart=1;d.io_advance=1;tick();d.io_restart=0;
        for (unsigned step=0;step<blocks*2+3;step++) {
          auto check = [&]() {
            const unsigned index=step+dirty,local=index%blocks;
            if (d.io_bankShift!=(index/blocks)%banks || d.io_cell!=(local/packed)%4) {
              std::cerr<<"FAIL blocks="<<blocks<<" dirty="<<dirty<<" packed="<<packed
                       <<" step="<<step<<" bank="<<unsigned(d.io_bankShift)
                       <<" cell="<<unsigned(d.io_cell)<<"\n";
              throw std::runtime_error("RTL address differs from original mapping");
            }
            checked++;
          };
          check();
          random^=random<<13;random^=random>>17;random^=random<<5;
          if (random&1) { d.io_advance=0;tick();check(); }
          d.io_advance=1;tick();
        }
      }
    }
  }
  d.final();
  std::cout<<"DIRECT RTL PASS banks="<<banks<<" checks="<<checked
           <<"; blocks 1.."<<maxBlocks<<", offsets 0..7, packing 1/2, stalls, restart priority, repeated bank/word wraps\n";
}

