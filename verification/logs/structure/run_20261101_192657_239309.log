"""Temporary regression wrapper: compare generated hardware before running ELFs."""
from pathlib import Path
import argparse,difflib,hashlib,json,re,sys
root=Path('/home/kioannou/chipyard_1.13.0/generators/LUMAX')
work=Path(__file__).resolve().parent
sys.dont_write_bytecode=True
sys.path.insert(0,str(root/'verification'))
import run_y_slice as y
hw=y.hw
logfile=Path((work/'log_path.txt').read_text())
def log(value):
    with logfile.open('a') as f:f.write(str(value)+'\n')
    print(value,flush=True)
def fir_modules(folder):
    files=[p for p in (folder/'generated-src').glob('*/*.fir') if p.name.endswith('LUMAXROcketConfig.fir')]
    assert len(files)==1,files
    data=files[0].read_text()
    data=re.sub(r'@\[[^\]]*\]','',data).replace(str(folder/'generated-src'),'<generated-src>')
    matches=list(re.finditer(r'(?m)^  (?:extmodule|intmodule|module)\s+(\S+)\s*:',data))
    modules={m[1]:'\n'.join(line.rstrip() for line in data[m.start():matches[i+1].start() if i+1<len(matches) else len(data)].splitlines()).rstrip() for i,m in enumerate(matches)}
    assert len(modules)==len(matches)>1000
    return modules
def sv_modules(folder):
    modules={}
    pattern=r'//[^\n]*|/\*[\s\S]*?\*/|"(?:\\.|[^"\\])*"|\s+|[A-Za-z_$][\w$]*|\d+|[^\w\s]'
    for p in (folder/'generated-src').glob('*/gen-collateral/*.sv'):
        data=p.read_text().replace(str(folder/'generated-src'),'<generated-src>')
        tokens=[m[0] for m in re.finditer(pattern,data) if not m[0].isspace() and not m[0].startswith(('//','/*'))]
        modules[p.name]=' '.join(tokens)
    assert modules
    return modules
def digest(modules):
    per_module={name:hashlib.sha256(body.encode()).hexdigest() for name,body in modules.items()}
    return hashlib.sha256(json.dumps(per_module,sort_keys=True).encode()).hexdigest()
checks=[]
original_sha=hw.sha
def checked_sha(path):
    p=Path(path)
    if p.name=='simulator-LUMAXROcketConfig' and p.parent.name in ['int16_ys1','fp16_ys2']:
        label=p.parent.name
        for kind,loader in [('FIRRTL',fir_modules),('SystemVerilog',sv_modules)]:
            old=loader(work/'baseline'/label);new=loader(p.parent)
            assert old.keys()==new.keys(),kind+' module set changed'
            changed=[name for name in old if old[name]!=new[name]]
            if changed:
                for name in changed[:5]:
                    delta='\n'.join(difflib.unified_diff(old[name].splitlines(),new[name].splitlines(),fromfile='before/'+name,tofile='after/'+name))
                    (work/(label+'_'+kind+'_'+name.replace('/','_')+'.diff')).write_text(delta)
                raise RuntimeError(f'{kind} differs in {changed}; see temporary comparison diffs')
            result=dict(configuration=label,representation=kind,modules_identical=len(old),normalized_sha256=digest(old))
            checks.append(result);log('GENERATED HARDWARE IDENTICAL: '+json.dumps(result,sort_keys=True))
            (work/'rtl_comparisons.json').write_text(json.dumps(checks,indent=2))
    return original_sha(path)
hw.sha=checked_sha
log('STRUCTURAL SOURCE AUDIT: '+(work/'structural_audit.json').read_text())
log('FIRRTL comparison ignores source-location annotations and temporary build-directory paths only; indentation, operators, widths, values, register/memory definitions and connections are retained. SystemVerilog comparison ignores comments/whitespace and temporary build-directory paths only.')
log('AFTER SOURCE SHA256: '+json.dumps({str(p.relative_to(root)):original_sha(p) for p in sorted((root/'src/main/scala').glob('*.scala')) if p!=hw.CONFIG},sort_keys=True))
args=argparse.Namespace(mode='both',y_slices=[1,2],b=2,rf=4,jobs=8,timeout=1800,build_timeout=7200,consecutive=True,interleaved_checks=False,pair_only=False,multirow_only=False)
before=set((root/'verification/logs/y_slice').glob('*.log'))
code=y.run(args)
new_logs=set((root/'verification/logs/y_slice').glob('*.log'))-before
assert len(new_logs)==1,new_logs
rowlog=new_logs.pop();(work/'row_log_path.txt').write_text(str(rowlog))
assert len(checks)==4,checks
log('ROW REGRESSION EXIT: '+str(code)+'; raw log: '+str(rowlog))
raise SystemExit(code)

