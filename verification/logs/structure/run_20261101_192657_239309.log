"""Prepare the structural edit offline and prove active tokens/comments survive."""
from pathlib import Path
from collections import Counter
import json,re
work=Path(__file__).resolve().parent
original=(work/'original/src/main/scala/LUMAX_Top.scala').read_text()

def lex(text):
    # Preserve Scala strings verbatim and ignore only whitespace/comments.
    pattern=r'//[^\n]*|/\*[\s\S]*?\*/|"(?:\\.|[^"\\])*"|\s+|[A-Za-z_$][\w$]*|\d+|[^\w\s]'
    tokens=[];comments=[]
    for m in re.finditer(pattern,text):
        token=m[0]
        if token.startswith('//') or token.startswith('/*'):comments.append(token.strip())
        elif not token.isspace():tokens.append(token)
    return tokens,comments

def format_scala(text):
    depth=parens=0;block=False;output=[]
    for line in text.splitlines():
        code=line.strip()
        if not code:
            if output and output[-1]!='':output.append('')
            continue
        # Strings and comments contain no braces relevant to indentation.
        clean=[];i=0
        while i<len(code):
            if block:
                end=code.find('*/',i)
                if end<0:break
                block=False;i=end+2
            elif code.startswith('//',i):break
            elif code.startswith('/*',i):block=True;i+=2
            elif code[i]=='"':
                i+=1
                while i<len(code):
                    if code[i]=='\\':i+=2
                    elif code[i]=='"':i+=1;break
                    else:i+=1
            else:clean.append(code[i]);i+=1
        active=''.join(clean)
        leading=len(re.match(r'^}*',active)[0])
        continuation=1 if (parens>0 and not code.startswith((')', '}'))) or code.startswith('(implicit ') else 0
        if code=='{' and output and output[-1].lstrip().startswith('for ('):
            output[-1]+=' {'
        else:
            output.append('  '*max(0,depth-leading+continuation)+code)
        depth+=active.count('{')-active.count('}')
        parens+=active.count('(')-active.count(')')
        assert depth>=0 and parens>=0,code
    assert depth==parens==0,(depth,parens)
    return '\n'.join(output).rstrip()+'\n'

start=original.index("    // Each lane's starting bank is known at elaboration.")
end=original.index('//////////////////////////////////////////////////////////////// Modules',start)
helper=original[start:end]
methods=re.findall(r'\bdef\s+(\w+)\s*\(',helper)
assert methods==['rotatedActivationBank','packedReadCount','storePackedResponse','dmaRequest','dmaResponce'],methods
moved=helper.replace('private def ','protected def ').replace('    def rotatedActivationBank(','    protected def rotatedActivationBank(')
helper_file='''package LUMAX_PACKAGE

import chisel3._
import chisel3.util._

// Existing Top helper methods, separated for navigation only. This trait has
// no registers, modules or eager connections of its own. Each method elaborates
// at its original call site, preserving that site's when/switch scope and
// assignment priority. All controller state remains in LUMAX_Top.scala.
trait LUMAXTopHelpers {
  this: LUMAXExampleModuleImpl =>

'''+moved+'}\n'
top=original[:start]+'  // Helper implementations are in LUMAXTopHelpers.scala.\n\n'+original[end:]
top=top.replace('extends LazyRoCCModuleImp(outer) with HasCoreParameters {','extends LazyRoCCModuleImp(outer) with HasCoreParameters with LUMAXTopHelpers {',1)
navigation='''// File map (all hardware state and assignment order are preserved):
//   1. Parameters, command decode, storage and register groups.
//   2. Submodule instances, default connections and shared selection cursors.
//   3. The six-state controller, kept together in execution order.
//   4. Counter readback and weight prefetch that run alongside the controller.
// Packing and DMA helper method bodies live in LUMAXTopHelpers.scala.
'''
top=top.replace('class LUMAXExampleModuleImpl(',navigation+'\nclass LUMAXExampleModuleImpl(',1)
sections=[
 ('  val params: LUMAXParams = outer.params','Parameters and elaboration requirements'),
 ('  // ROCC interface','Command interface and instruction decode'),
 ('  //SyncMem compile parameters','Memory geometry'),
 ('  val done          = RegInit(false.B)','Completion and selection-control registers'),
 ('  //How many X_reg will neeed in worst case','Scratchpad capacity constants'),
 ('  // Create Scratchpad Memory','Output accumulators and activation/weight memories'),
 ('  // ------------- Sync Read Memory System ----- VERSION 2 ------------- //','DMA response carry and split bookkeeping'),
 ('  // counter register to iterate rows -- for I_MEM','Activation scratchpad read registers'),
 ('  // counter register to iterate rows -- for W_MEM','Weight scratchpad read and validity registers'),
 ('  //Double Bufferig Parameters','Weight double-buffer registers'),
 ('  //Create SyncReadMems (Memory Blocks to store Prodcuts)','Product-table storage and generation/select counters'),
 ('  // Index counters','Output-column and row-group progress'),
 ('  //Indexer for Matrices','Matrix-coordinate registers'),
 ('  //Register to save dimension values','Runtime matrix dimensions and slice settings'),
 ('  //bitwidths','Runtime element formats and performance counters'),
 ('  //Dynamic Input Paramters','Activation validity and packed-element metadata'),
 ('  //Dynamic Bitwidth','Product-table geometry and precision masks'),
 ('  //indexing extra registers','DMA request/response coordinates and chunk sizes'),
 ('  //----------------------------->  Pipeline Stages','Selection pipeline registers and shared address counters'),
 ('//////////////////////////////////////////////////////////////// Modules','Submodule instances and default connections'),
 ('  //DMA Module inputs','DMA interface defaults'),
 ('  // ChunkSignExtender Module','Activation chunk extenders'),
 ('  // Product Generator Mesh Module','Parallel product generators (b times Y_SLICE)'),
 ('  //A Chunk Offset Module','DMA address/chunk-info modules'),
 ('  //////////////////////////////////////////// FSM Implementation','Main controller: six states'),
 ('    is(sIdle) {','State 1: accept configuration and start a matmul'),
 ('  is(sLoadX) {','State 2: load activation rows into scratchpads'),
 ('is(sGenerateRegFiles) {','State 3: generate lookup products for each activation lane'),
 ('is(sLoadW_and_sSelectAndAccumulate) {','State 4: consume weight buffers, select products and accumulate'),
 ('is(sStoreOutput) {','State 5: convert/store output rows and advance row groups'),
 ('      is(sDELAY) {','State 6: wait for DMA drain and completion acknowledgement'),
 ('  val counter_p = RegInit(0.U(5.W))','Performance-counter readback (outside the state switch)'),
 ('  when( ( buffers_mode.map(! _).reduce(_ || _)','Background weight prefetch (overlaps generation and selection)'),
]
for anchor,title in sections:
    assert anchor in top,anchor
    top=top.replace(anchor,'  // === '+title+' ===\n'+anchor,1)
formatted_top=format_scala(top)
formatted_helper=format_scala(helper_file)

# All active controller tokens stay in the same order. The only added token
# sequence is the Scala helper-trait mixin, which introduces no hardware state.
old_body=original[:start]+original[end:]
new_body=formatted_top.replace(' with LUMAXTopHelpers','',1)
assert lex(old_body)[0]==lex(new_body)[0], 'Active controller tokens changed'
assert lex(moved)[0]==lex(formatted_helper.split('this: LUMAXExampleModuleImpl =>',1)[1].rsplit('}',1)[0])[0]
old_comments=Counter(lex(original)[1])
new_comments=Counter(lex(formatted_top)[1]+lex(formatted_helper)[1])
assert not (old_comments-new_comments), list((old_comments-new_comments).elements())
candidate=work/'candidate';candidate.mkdir(exist_ok=True)
